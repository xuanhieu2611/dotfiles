{
    "title": "Developer navigation",
    "rules": [
        {
            "description": "Caps Esc/Ctrl + Right Command Hyper",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_control",
                            "lazy": true
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "escape"
                        }
                    ],
                    "parameters": {
                        "basic.to_if_alone_timeout_milliseconds": 200
                    }
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "right_command",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "left_shift",
                            "modifiers": [
                                "left_control",
                                "left_option",
                                "left_command"
                            ],
                            "lazy": true
                        }
                    ]
                }
            ]
        }
    ]
}
